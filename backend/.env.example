# Copia este archivo a .env y rellena los valores reales.
# NUNCA subas .env al repositorio — está en .gitignore.

# PostgreSQL (local)
DATABASE_URL=postgresql+asyncpg://postgres:CAMBIAR_PASSWORD@localhost:5432/milpin_mvp

# Groq API — cubre LLM (NLU/intent) + STT (whisper-large-v3)
# Una sola key para toda la capa de voz. Obtener en: https://console.groq.com/keys
GROQ_API_KEY=gsk_CAMBIAR_POR_KEY_REAL

# ElevenLabs TTS — voz mexicana de alta calidad
# Obtener en: https://elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=sk_CAMBIAR_POR_KEY_REAL
ELEVENLABS_VOICE_ID=qWWAqFomnJ99VwQLREfT
